# This file contains examples only. Keep actual secrets outside Git and images.
CANVAS_ORIGIN=https://canvas.example.com
NEW_API_URL=http://new-api:3000
NEW_API_PUBLIC_URL=https://new-api.example.com
NEW_API_CLIENT_ID=infinite-canvas
NEW_API_CLIENT_SECRET=
# Generate with: bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CANVAS_SESSION_ENCRYPTION_KEY=
DATA_DIR=./data
# Compose requires an explicit Nginx timeout aligned with the configured gateway.
CANVAS_PROXY_READ_TIMEOUT=
