log_format canvas_without_args '$remote_addr $request_method $uri $status';
map "" $canvas_csp {
    default "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'";
}

server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    access_log /var/log/nginx/access.log canvas_without_args;

    # Upload admission remains subject to Bun and the New API gateway. This
    # ingress does not silently impose Nginx's default 1 MiB upload boundary.
    client_max_body_size 0;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy $canvas_csp always;

    location /auth/ {
        # Nginx upstream errors include the raw request line (and callback code).
        # Suppress only this ingress error sink. BFF structured security events
        # remain enabled; API/static service diagnostics retain their error log.
        error_log /dev/null;
        proxy_pass http://canvas-server:3001;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout ${CANVAS_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${CANVAS_PROXY_READ_TIMEOUT};
        proxy_buffering off;
        add_header Cache-Control no-store always;
        add_header Referrer-Policy no-referrer always;
    }

    location /api/ {
        proxy_pass http://canvas-server:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout ${CANVAS_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${CANVAS_PROXY_READ_TIMEOUT};
    }

    location = /config.js {
        add_header Cache-Control no-store always;
        # A location-level add_header replaces inherited add_header directives.
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
        add_header Cross-Origin-Resource-Policy same-origin always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy $canvas_csp always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
